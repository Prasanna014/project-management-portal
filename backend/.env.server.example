# Backend runtime environment for Linux server deployment
# Copy this file to your server as .env (or export these variables in shell/systemd).

SERVER_PORT=8080

# PostgreSQL connection used by Spring Boot
DB_HOST=<POSTGRES_HOST_OR_IP>
DB_PORT=5432
DB_NAME=project_management
DB_USERNAME=<POSTGRES_USERNAME>
DB_PASSWORD=<POSTGRES_PASSWORD>

# JWT settings (must be strong in production)
JWT_SECRET=<PUT_A_LONG_RANDOM_SECRET_32_PLUS_CHARS>
JWT_EXPIRATION_MS=3600000

# Optional JPA tuning
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
